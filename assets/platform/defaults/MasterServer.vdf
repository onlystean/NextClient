"MasterServer"
{
	// DUSTX: own HTTP master. HttpMasterClient does GET on this URL and parses
	// the reply as newline-separated ip:port. Served by dustx-masterserver.
	"Selected"		"0"
	"CacheServers"		"1"
	"Servers"
	{
		"DustX"
		{
			"address"		"http://dustx.ru/masterserver/serverlist"
			"site"		"https://dustx.ru/"
			"region"		"255"
		}
		"Steam"
		{
			"address"		"hl1master.steampowered.com:27011"
			"site"		""
			"region"		"3"
			"QueryDelay"		"2500"
			"NextRequestDelay"		"2500"
		}
	}
}
